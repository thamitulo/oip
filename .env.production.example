# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in. Never commit .env.

# Public domain name (DNS A record must point at the server before first start), e.g. oip.example.co.za
OIP_DOMAIN=
# Let's Encrypt expiry notices
OIP_ACME_EMAIL=

# --- Database ---  openssl rand -base64 32
OIP_DB_PASSWORD=
OIP_BACKUP_KEEP_DAYS=14

# --- Security ---  openssl rand -base64 48
OIP_JWT_SECRET=

# --- First platform administrator: set for the first start, then remove and restart ---
OIP_BOOTSTRAP_ADMIN_EMAIL=
OIP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Crawler ---
OIP_CRAWLER_SCHEDULER_ENABLED=true
# Identify the crawler with a real page or address where source operators can reach you.
OIP_CRAWLER_USER_AGENT="OIP-Crawler/1.0 (+https://your-domain/crawler)"

# --- E-mail (e.g. Amazon SES SMTP, Brevo, Mailgun) ---
OIP_MAIL_ENABLED=true
OIP_MAIL_HOST=
OIP_MAIL_PORT=587
OIP_MAIL_USERNAME=
OIP_MAIL_PASSWORD=
OIP_MAIL_FROM=no-reply@your-domain

# --- AI (optional) ---
ANTHROPIC_API_KEY=

OIP_LOG_FORMAT=ecs
