# Copy to .env and fill in. Never commit .env.

# --- Database ---
OIP_DB_PASSWORD=change-me

# --- Security ---
# At least 32 random characters, e.g.:  openssl rand -base64 48
OIP_JWT_SECRET=
OIP_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Access/refresh token lifetimes (ISO-8601 durations)
# OIP_ACCESS_TOKEN_TTL=PT15M
# OIP_REFRESH_TOKEN_TTL=P14D
# OIP_AUTH_RATE_LIMIT_PER_MINUTE=30

# --- First platform administrator (created once, only if none exists) ---
OIP_BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters
OIP_BOOTSTRAP_ADMIN_PASSWORD=
# OIP_BOOTSTRAP_ADMIN_TENANT=Platform Operations

# --- Crawler ---
# Scheduled crawling is off by default locally; set true to crawl enabled sources daily.
OIP_CRAWLER_SCHEDULER_ENABLED=false
# Identify the crawler honestly and give source operators a way to contact you.
OIP_CRAWLER_USER_AGENT="OIP-Crawler/0.1 (+https://example.invalid/crawler)"
# OIP_CRAWLER_MAX_CONCURRENT=2
# OIP_CRAWLER_REQUEST_TIMEOUT=PT30S

# --- AI (optional) ---
# Claude API key. Without it, AI features (assistant, AI match assessment, classification) report themselves
# unavailable and everything else works. Model, effort and limits are set in Administration -> AI settings.
ANTHROPIC_API_KEY=

# --- Mail (notifications) ---
# Docker Compose sends mail to the bundled Mailpit (http://localhost:8025). Point these at real SMTP in production.
# OIP_MAIL_ENABLED=true
# OIP_MAIL_HOST=mailpit
# OIP_MAIL_PORT=1025
# OIP_MAIL_USERNAME=
# OIP_MAIL_PASSWORD=
# OIP_MAIL_FROM=no-reply@your-domain
# OIP_APP_URL=http://localhost:4200

# --- Cookies ---
# The refresh-token cookie is Secure (HTTPS only) by default. Compose sets false for plain-HTTP localhost.
# OIP_SECURE_COOKIES=true

# --- Documents ---
# OIP_STORAGE_DIR=/data/storage
# OIP_DOCUMENTS_RETENTION_DAYS=90

# --- Logging ---
# Set to "ecs" or "logstash" for structured JSON logs in production
OIP_LOG_FORMAT=
# OIP_LOG_LEVEL=INFO
